<?xml version="1.0" ?>
<configuration>
    <input>
        <net-file value="dense_network.net.xml"/>
        <route-files value="dense_network.rou.xml"/>
        <additional-files value="dense_network.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="7200"/>
        <step-length value="1.0"/>
    </time>
    <processing>
        <collision.action value="warn"/>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>

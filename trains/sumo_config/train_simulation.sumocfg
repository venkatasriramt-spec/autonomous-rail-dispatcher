<?xml version="1.0" ?>
<configuration>
    <input>
        <net-file value="../../tracks/network_data/dense_network.net.xml"/>
        <additional-files value="../../tracks/network_data/dense_network.add.xml"/>
        <route-files value="trains.rou.xml"/>
    </input>
    <time>
